# Modal credentials (run: modal token new)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# HuggingFace - need Llama 3.1-8B-Instruct license accepted
HF_TOKEN=

# Anthropic API (fallback agent backbone + LLM judge for failure labeling)
ANTHROPIC_API_KEY=

# Cloudflare (optional - for R2 storage and Pages deploy)
CF_API_TOKEN=
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inside-the-agent-trajectories

# Brain-server URL (set after modal deploy)
BRAIN_SERVER_URL=https://your-modal-app--inside-the-agent.modal.run
